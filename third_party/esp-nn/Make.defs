# Deliberately no CFLAGS/CXXFLAGS here.  Include paths added in this file are
# global: they also reach the NuttX kernel build through EXTRAFLAGS.  The
# compat/ directory holds an esp_timer.h replacement, which would then shadow
# the real ESP-IDF esp_timer.h used by arch/xtensa/src/esp32s3 and break the
# Wi-Fi PHY sources.  Only the ESP-NN library itself and the TFLite Micro
# kernel wrappers need these paths, and both add them locally.

ifneq ($(CONFIG_MLEARNING_ESP_NN),)
CONFIGURED_APPS += $(APPDIR)/mlearning/esp-nn
endif
