+static bool button_boot_sample(bool debounce)
+{
+  bool state = esp32s3_gpioread(BUTTON_BOOT);
+  int stable = 0;
+  int i;
+
+  if (!debounce)
+    {
+      return state;
+    }
+
+  for (i = 0; i < 10 && stable < 3; i++)
+    {
+      bool next;
+
+      up_mdelay(1);
+      next = esp32s3_gpioread(BUTTON_BOOT);
+      if (next == state)
+        {
+          stable++;
+        }
+      else
+        {
+          state = next;
+          stable = 0;
+        }
+    }
+
+  return state;
+}
