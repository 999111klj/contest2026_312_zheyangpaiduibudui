+#include <sys/boardctl.h>
+
 #include <stdint.h>
 #include <stdbool.h>
 #include <stdio.h>
@@ -295,7 +297,7 @@ int nximage_initialize(void)
  * Name: nximage_draw
  *
  * Description:
- *   Put the NuttX logo in the center of the display.
+ *   Center-crop and draw an RGB image on the background window.
  *
  ****************************************************************************/
 
@@ -304,25 +306,41 @@ void nximage_draw(FAR void *image, int w, int h)
   FAR struct nxgl_point_s origin;
   FAR struct nxgl_rect_s dest;
   FAR const void *src[CONFIG_NX_NPLANES];
+  nxgl_coord_t copy_w;
+  nxgl_coord_t copy_h;
+  nxgl_coord_t src_x;
+  nxgl_coord_t src_y;
   int ret;
 
-  origin.x = 0;
-  origin.y = 0;
+  if (image == NULL || w <= 0 || h <= 0)
+    {
+      return;
+    }
+
+  /* Center-crop images larger than the LCD and center images that are
+   * smaller.  NX expects origin to describe the full source bitmap in
+   * window coordinates, while stride remains the full source row width.
+   */
 
-  /* Set up the destination to whole LCD screen */
+  copy_w = w < g_nximage.xres ? w : g_nximage.xres;
+  copy_h = h < g_nximage.yres ? h : g_nximage.yres;
+  src_x = (w - copy_w) / 2;
+  src_y = (h - copy_h) / 2;
 
-  dest.pt1.x = 0;
-  dest.pt1.y = 0;
-  dest.pt2.x = g_nximage.xres - 1;
-  dest.pt2.y = g_nximage.yres - 1;
+  dest.pt1.x = (g_nximage.xres - copy_w) / 2;
+  dest.pt1.y = (g_nximage.yres - copy_h) / 2;
+  dest.pt2.x = dest.pt1.x + copy_w - 1;
+  dest.pt2.y = dest.pt1.y + copy_h - 1;
 
+  origin.x = dest.pt1.x - src_x;
+  origin.y = dest.pt1.y - src_y;
   src[0] = image;
 
   ret = nx_bitmap(g_nximage.hbkgd, &dest, src, &origin,
-                  g_nximage.xres * sizeof(nxgl_mxpixel_t));
+                  w * sizeof(nxgl_mxpixel_t));
   if (ret < 0)
     {
-      printf("nximage_image: nx_bitmap failed: %d\n", errno);
+      printf("nximage_draw: nx_bitmap failed: %d\n", errno);
     }
 }
 
