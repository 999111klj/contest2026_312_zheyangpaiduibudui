+static int tls_write_all_until(tls_ctx_t* ctx, const unsigned char* data,
+    size_t len, int64_t deadline_ms)
+{
+    size_t written = 0;
+
+    while (written < len) {
+        size_t chunk = len - written;
+        int ret;
+
+        if (chunk > VELA_TLS_WRITE_CHUNK_SIZE) {
+            chunk = VELA_TLS_WRITE_CHUNK_SIZE;
+        }
+
+        ret = mbedtls_ssl_write(&ctx->ssl, data + written, chunk);
+
+        if (ret > 0) {
+            written += (size_t)ret;
+
+            /* Avoid filling the buffered TCP and Wi-Fi queues in a burst.
+             * The ESP32-S3 vendor driver has only a small static TX credit
+             * pool; pacing also lets ACK processing release write buffers.
+             */
+
+            usleep(VELA_TLS_WRITE_PACE_US);
+            continue;
+        }
+
+        if (ret == MBEDTLS_ERR_SSL_WANT_WRITE
+            || ret == MBEDTLS_ERR_SSL_WANT_READ) {
+            int64_t now_ms = tls_monotonic_ms();
+
+            if (now_ms < 0 || now_ms >= deadline_ms) {
+                syslog(LOG_ERR,
+                    "[%s] TLS request upload timed out at %zu/%zu bytes\n",
+                    TAG, written, len);
+                shutdown(ctx->net.fd, SHUT_RDWR);
+                return VELA_TLS_ERR_WRITE;
+            }
+
+            usleep(VELA_TLS_WRITE_RETRY_US);
+            continue;
+        }
+
+        return VELA_TLS_ERR_WRITE;
+    }
+
+    return 0;
+}
