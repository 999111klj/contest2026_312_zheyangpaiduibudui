+    for (size_t i = 0; i < count; i++) {
+        if (!pairs[i].key || !pairs[i].value) {
+            errno = EINVAL;
+            ret = ERROR;
+            break;
+        }
+        cJSON_DeleteItemFromObject(root, pairs[i].key);
+        if (!cJSON_AddStringToObject(root, pairs[i].key, pairs[i].value)) {
+            errno = ENOMEM;
+            ret = ERROR;
+            break;
+        }
+    }
+
+    if (ret == OK)
+        ret = save_json(root);
+    cJSON_Delete(root);
+    pthread_mutex_unlock(&s_lock);
+    return ret;
