+        if (tls->write_nonblocking) {
+            return MBEDTLS_ERR_SSL_WANT_READ;
+        }
+
+        syslog(LOG_WARNING, "[%s] TLS socket receive timeout: errno=%d\n",
+            TAG, err);
+        return MBEDTLS_ERR_SSL_TIMEOUT;
+    }
+
+    if (err == ETIMEDOUT) {
+        syslog(LOG_WARNING, "[%s] TLS socket receive timeout: errno=%d\n",
+            TAG, err);
+        return MBEDTLS_ERR_SSL_TIMEOUT;
