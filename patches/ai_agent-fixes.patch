+
+static int http_write_all(int fd, FAR const void *buffer, size_t length)
+{
+    FAR const uint8_t *cursor = buffer;
+
+    while (length > 0) {
+        ssize_t written = send(fd, cursor, length, 0);
+        if (written < 0 && errno == EINTR) {
+            continue;
+        }
+        if (written <= 0) {
+            return VELA_TLS_ERR_WRITE;
+        }
+        cursor += written;
+        length -= (size_t)written;
+    }
+
+    return 0;
+}
+
+int vela_http_request(const char* host, const char* port,
+    const char* method, const char* path,
+    const vela_header_t* headers,
+    const char* body, size_t body_len,
+    char* resp_buf, size_t resp_cap, size_t* out_body_len)
+{
+    struct addrinfo hints;
+    struct addrinfo* addresses = NULL;
+    struct addrinfo* address;
+    struct timeval timeout;
+    char header[VELA_TLS_HDR_BUF];
+    char* raw = NULL;
+    char* body_start;
+    size_t raw_len = 0;
+    size_t response_len = 0;
+    long content_length = -1;
+    int chunked = 0;
+    int fd = -1;
+    int position = 0;
+    int status = VELA_TLS_ERR_CONNECT;
+    int gai;
+
+    if (!host || !host[0] || !port || !port[0] || !method || !method[0] ||
+        !path || path[0] != '/' || (!body && body_len != 0) ||
+        !resp_buf || resp_cap == 0) {
+        return VELA_TLS_ERR_WRITE;
+    }
+
+    resp_buf[0] = '\0';
+    if (out_body_len) {
+        *out_body_len = 0;
+    }
+
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    gai = getaddrinfo(host, port, &hints, &addresses);
+    if (gai != 0 || !addresses) {
+        syslog(LOG_INFO, "http: endpoint lookup failed: %d", gai);
+        return VELA_TLS_ERR_CONNECT;
+    }
+
+    timeout.tv_sec = AGENT_LLM_SOCKET_TIMEOUT_SEC;
+    timeout.tv_usec = 0;
+    for (address = addresses; address; address = address->ai_next) {
+        fd = socket(address->ai_family, address->ai_socktype,
+            address->ai_protocol);
+        if (fd < 0) {
+            continue;
+        }
+        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+        setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+        if (connect(fd, address->ai_addr, address->ai_addrlen) == 0) {
+            break;
+        }
+        close(fd);
+        fd = -1;
+    }
+    freeaddrinfo(addresses);
+    if (fd < 0) {
+        return VELA_TLS_ERR_CONNECT;
+    }
+
+#define HTTP_APPEND(...) do {                                                \
+    int added = snprintf(header + position, sizeof(header) - position,        \
+        __VA_ARGS__);                                                         \
+    if (added < 0 || (size_t)added >= sizeof(header) - (size_t)position) {    \
+        status = VELA_TLS_ERR_OVERFLOW;                                       \
+        goto out;                                                             \
+    }                                                                         \
+    position += added;                                                        \
+} while (0)
+
+    HTTP_APPEND("%s %s HTTP/1.1\r\n", method, path);
+    if (strcmp(port, "80") == 0) {
+        HTTP_APPEND("Host: %s\r\n", host);
+    } else {
+        HTTP_APPEND("Host: %s:%s\r\n", host, port);
+    }
+    HTTP_APPEND("Connection: close\r\n");
+    HTTP_APPEND("User-Agent: openvela-aivlog/1.0\r\n");
+    HTTP_APPEND("Content-Length: %zu\r\n", body_len);
+    if (headers) {
+        FAR const vela_header_t* entry;
+        for (entry = headers; entry->name; entry++) {
+            if (!entry->value || strchr(entry->name, '\r') ||
+                strchr(entry->name, '\n') || strchr(entry->value, '\r') ||
+                strchr(entry->value, '\n')) {
+                status = VELA_TLS_ERR_WRITE;
+                goto out;
+            }
+            HTTP_APPEND("%s: %s\r\n", entry->name, entry->value);
+        }
+    }
+    HTTP_APPEND("\r\n");
+#undef HTTP_APPEND
+
+    status = http_write_all(fd, header, (size_t)position);
+    if (status != 0) {
+        goto out;
+    }
+    if (body_len > 0) {
+        status = http_write_all(fd, body, body_len);
+        if (status != 0) {
+            goto out;
+        }
+    }
+
+    raw = malloc(TLS_RAW_BUF_SIZE);
+    if (!raw) {
+        status = VELA_TLS_ERR_READ;
+        goto out;
+    }
+
+    body_start = NULL;
+    while (raw_len < TLS_RAW_BUF_SIZE - 1) {
+        ssize_t count = recv(fd, raw + raw_len,
+            TLS_RAW_BUF_SIZE - 1 - raw_len, 0);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            break;
+        }
+        raw_len += (size_t)count;
+        raw[raw_len] = '\0';
+        body_start = memmem(raw, raw_len, "\r\n\r\n", 4);
+        if (body_start) {
+            break;
+        }
+    }
+    raw[raw_len] = '\0';
+    if (!body_start) {
+        status = raw_len == TLS_RAW_BUF_SIZE - 1 ?
+            VELA_TLS_ERR_OVERFLOW : VELA_TLS_ERR_READ;
+        goto out;
+    }
+    if (sscanf(raw, "HTTP/1.%*d %d", &status) != 1 || status < 100 ||
+        status > 599) {
+        status = VELA_TLS_ERR_READ;
+        goto out;
+    }
+
+    body_start += 4;
+    {
+        char* value = strcasestr(raw, "Content-Length:");
+        if (value && value < body_start) {
+            content_length = strtol(value + strlen("Content-Length:"),
+                NULL, 10);
+            if (content_length < 0 || content_length > 10 * 1024 * 1024) {
+                content_length = -1;
+            }
+        }
+    }
+    {
+        char* value = strcasestr(raw, "Transfer-Encoding:");
+        if (value && value < body_start) {
+            chunked = strcasestr(value, "chunked") != NULL;
+        }
+    }
+
+    {
+        size_t initial = (size_t)(raw + raw_len - body_start);
+        size_t copy = initial < resp_cap - 1 ? initial : resp_cap - 1;
+        memcpy(resp_buf, body_start, copy);
+        response_len = copy;
+    }
+
+    while (response_len < resp_cap - 1 &&
+        (content_length < 0 || (long)response_len < content_length)) {
+        ssize_t count = recv(fd, resp_buf + response_len,
+            resp_cap - 1 - response_len, 0);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            break;
+        }
+        response_len += (size_t)count;
+    }
+    resp_buf[response_len] = '\0';
+    if (chunked) {
+        response_len = decode_chunked(resp_buf, response_len);
+        resp_buf[response_len] = '\0';
+    }
+    if (out_body_len) {
+        *out_body_len = response_len;
+    }
+
+out:
+    free(raw);
+    if (fd >= 0) {
+        close(fd);
+    }
+    return status;
+}
