+static int vela_tls_net_recv(void* context, unsigned char* buf, size_t len)
+{
+    tls_ctx_t* tls = context;
+    mbedtls_net_context* net = tls ? &tls->net : NULL;
+    ssize_t ret;
+    int err;
+
+    if (!net || net->fd < 0) {
+        return MBEDTLS_ERR_NET_INVALID_CONTEXT;
+    }
+
+    ret = recv(net->fd, buf, len, 0);
+    if (ret >= 0) {
+        return (int)ret;
+    }
+
+    err = errno;
+    if (err == EINTR) {
+        return MBEDTLS_ERR_SSL_WANT_READ;
+    }
+
+    if (err == EAGAIN
+#if defined(EWOULDBLOCK) && EWOULDBLOCK != EAGAIN
+        || err == EWOULDBLOCK
+#endif
