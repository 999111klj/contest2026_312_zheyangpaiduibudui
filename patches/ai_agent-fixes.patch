+static int tls_verify_certificate_pin(tls_ctx_t* ctx,
+    const char* cert_sha256_hex)
+{
+    const mbedtls_x509_crt* peer;
+    unsigned char expected[32];
+    unsigned char actual[32];
+    unsigned char difference = 0;
+    int high;
+    int low;
+
+    if (!cert_sha256_hex || strlen(cert_sha256_hex) != 64)
+        return VELA_TLS_ERR_VERIFY;
+
+    for (size_t i = 0; i < sizeof(expected); i++) {
+        high = tls_hex_nibble(cert_sha256_hex[i * 2]);
+        low = tls_hex_nibble(cert_sha256_hex[i * 2 + 1]);
+        if (high < 0 || low < 0)
+            return VELA_TLS_ERR_VERIFY;
+        expected[i] = (unsigned char)((high << 4) | low);
+    }
+
+    peer = mbedtls_ssl_get_peer_cert(&ctx->ssl);
+    if (!peer || !peer->raw.p || peer->raw.len == 0)
+        return VELA_TLS_ERR_VERIFY;
+
+    if (mbedtls_sha256(peer->raw.p, peer->raw.len, actual, 0) != 0)
+        return VELA_TLS_ERR_VERIFY;
+
+    for (size_t i = 0; i < sizeof(expected); i++)
+        difference |= expected[i] ^ actual[i];
+
+    if (difference != 0) {
+        syslog(LOG_ERR, "[%s] Peer certificate SHA-256 pin mismatch\n", TAG);
+        return VELA_TLS_ERR_VERIFY;
+    }
+
+    return 0;
+}
