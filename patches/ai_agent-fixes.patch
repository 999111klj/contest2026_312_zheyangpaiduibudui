+static bool http_text_valid(FAR const char *text, bool header_name)
+{
+    FAR const unsigned char *cursor = (FAR const unsigned char *)text;
+
+    if (!text || !text[0]) {
+        return false;
+    }
+
+    while (*cursor) {
+        if (*cursor < 0x20 || *cursor == 0x7f ||
+            (header_name && (*cursor == ':' || *cursor == ' ' ||
+                             *cursor == '\t'))) {
+            return false;
+        }
+        cursor++;
+    }
+
+    return true;
+}
