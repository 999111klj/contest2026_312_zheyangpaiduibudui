# aivlog_server 配置模板（实际部署时填真实值，文件权限 600，切勿提交真实密钥）
AIVLOG_DEVICE_TOKEN=<48位设备token>
AIVLOG_DATA_DIR=/home/<user>/.local/share/aivlog-server/data
AIVLOG_HOST=0.0.0.0
AIVLOG_PORT=443
AIVLOG_PUBLIC_BASE_URL=https://<服务器IP>
AIVLOG_TLS_CERTFILE=/path/to/server.crt
AIVLOG_TLS_KEYFILE=/path/to/server.key
MIFY_API_KEY=<LLM网关密钥>
MIFY_BASE_URL=https://api.llm.mioffice.cn/v1
MIFY_PROVIDER=xiaomi
MIFY_MODEL=mimo-v2.5
